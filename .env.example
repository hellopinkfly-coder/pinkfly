# Public variables (exposed to the browser) must be prefixed with NEXT_PUBLIC_
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Join Community form -----------------------------------------------------
# Google Form that backs the "Your seat is waiting" CTA across the site.
# Set it and every CTA opens the form in a new tab; leave it empty and they
# link to the on-site /join page, which carries the same membership form.
# The global form is the fallback for every region; set a region-specific
# URL to override it.
NEXT_PUBLIC_JOIN_FORM_URL=
NEXT_PUBLIC_JOIN_FORM_URL_INDIA=
NEXT_PUBLIC_JOIN_FORM_URL_DUBAI=
NEXT_PUBLIC_JOIN_FORM_URL_USA=

# Server-only variables
# API_BASE_URL=

# --- Sanity CMS --------------------------------------------------------------
# All site content — every headline, paragraph, image, card, link and section
# visibility switch — is edited in the Studio at /studio.
#
# The Pink Fly project (5t0hmzzq / production) is the built-in default, so a
# deploy needs no configuration here. Set these only to point the site at a
# different project or dataset; set the id to an empty string to fall back to
# the seed content committed in src/config and src/data.
NEXT_PUBLIC_SANITY_PROJECT_ID=5t0hmzzq
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-10-01

# Write token, server-only. Needed ONLY to run `npm run seed:sanity`, which
# imports the shipped content into a fresh dataset. Never expose this.
SANITY_API_WRITE_TOKEN=

# Shared secret for the Sanity publish webhook that purges the CMS cache.
# Set the same value here and in Sanity → Manage → API → Webhooks → Secret.
# Optional: without it the site still refreshes on its own every 60 seconds,
# and /api/revalidate refuses to purge.
SANITY_REVALIDATE_SECRET=

# Public variables (exposed to the browser) must be prefixed with NEXT_PUBLIC_
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Join Community form -----------------------------------------------------
# Google Form that backs the "Your seat is waiting" CTA across the site.
# Set it and every CTA opens the form in a new tab; leave it empty and they
# link to the on-site /join page, which carries the same membership form.
# The global form is the fallback for every region; set a region-specific
# URL to override it.
NEXT_PUBLIC_JOIN_FORM_URL=
NEXT_PUBLIC_JOIN_FORM_URL_INDIA=
NEXT_PUBLIC_JOIN_FORM_URL_DUBAI=
NEXT_PUBLIC_JOIN_FORM_URL_USA=

# --- CRM ---------------------------------------------------------------------
# Server-side endpoint that receives form submissions and creates the CRM
# record. Leads carry the region's `crmSegment` so they can be routed.
CRM_WEBHOOK_URL=

# Server-only variables
# API_BASE_URL=
